LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=
# Optional 429 fallback for the agent model (OpenRouter). Blank key → no fallback, Groq
# retries longer instead. Blank model → DEFAULT_OPENROUTER_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Eval-only LLM judge (Groq model id); blank → DEFAULT_JUDGE_MODEL in config.py.
JUDGE_MODEL=
# Query classifier that picks prompt modules (Groq model id); blank → DEFAULT_ROUTER_MODEL.
ROUTER_MODEL=
# on (default) | off. off skips the classifier: core + every prompt module, every tool bound.
ROUTING=

SERVER_PORT=7860

CHROMA_PATH=
# Seller preference store directory; blank → data/memory. See docs/memory.md.
MEMORY_PATH=
# on (default) | off. off disables the embedding and tool-result caches.
CACHING=
# Cache sizes / tool-result TTL (seconds); blank → code defaults 1024 / 256 / 300.
# For a demo where eviction and expiry show up live, try 8 / 5 / 60.
CACHE_EMBED_MAX=
CACHE_TOOL_MAX=
CACHE_TOOL_TTL_S=
# Required, no default: the tenant every tool is bound to (dataset uses SELLER-001).
# Prototype stand-in for auth; see docs/tools.md §1.
SELLER_ID=
